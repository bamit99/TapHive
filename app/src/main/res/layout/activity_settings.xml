<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/neon_button_ghost"
                android:text="@string/back"
                style="@style/NeonSmallButton" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/neon_button_ghost"
                android:text="@string/info"
                style="@style/NeonSmallButton" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="@string/settings_title"
            style="@style/NeonTitle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:background="@drawable/neon_card"
            android:orientation="vertical">

            <CheckBox
                android:id="@+id/syslog_enabled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="@color/neon_cyan"
                android:text="Enable syslog forwarding (cleartext)"
                android:textColor="@color/neon_text" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="HOST"
                style="@style/NeonLabel" />

            <EditText
                android:id="@+id/syslog_host"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="192.168.1.10"
                android:inputType="textUri"
                style="@style/NeonField" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="PORT / FACILITY"
                style="@style/NeonLabel" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/syslog_port"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="514"
                    android:inputType="number"
                    style="@style/NeonField" />

                <EditText
                    android:id="@+id/syslog_facility"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:hint="13"
                    android:inputType="number"
                    style="@style/NeonField" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="TRANSPORT"
                style="@style/NeonLabel" />

            <Spinner
                android:id="@+id/syslog_transport"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/neon_field" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="APP NAME"
                style="@style/NeonLabel" />

            <EditText
                android:id="@+id/syslog_app_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="TapHive"
                android:inputType="text"
                style="@style/NeonField" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/neon_card"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CAPTURE"
                style="@style/NeonLabel" />

            <CheckBox
                android:id="@+id/start_at_boot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:buttonTint="@color/neon_cyan"
                android:text="Start capture at boot"
                android:textColor="@color/neon_text" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="34dp"
                android:text="Resumes only if capture was left running"
                android:textColor="@color/neon_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/neon_card"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LOCAL HISTORY"
                style="@style/NeonLabel" />

            <Spinner
                android:id="@+id/retention"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/neon_field" />

            <Button
                android:id="@+id/clear_history"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/neon_button_cyan"
                android:text="CLEAR HISTORY"
                style="@style/NeonButton" />
        </LinearLayout>

        <Button
            android:id="@+id/save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/neon_button_cyan"
            android:text="SAVE SETTINGS"
            style="@style/NeonButton" />

        <TextView
            android:id="@+id/error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/neon_magenta" />
    </LinearLayout>
</ScrollView>
