<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="@color/neon_bg_end"
                android:startColor="@color/neon_bg"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.5"
                android:centerY="0.0"
                android:endColor="#00000000"
                android:gradientRadius="1000dp"
                android:startColor="#123A55"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
