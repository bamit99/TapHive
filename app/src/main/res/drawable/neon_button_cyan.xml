<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:endColor="@color/neon_cyan" android:startColor="#00A8C8" />
            <corners android:radius="12dp" />
            <stroke android:color="@color/neon_cyan_soft" android:width="1dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:endColor="#0A6070" android:startColor="#063A4A" />
            <corners android:radius="12dp" />
            <stroke android:color="@color/neon_cyan" android:width="2dp" />
        </shape>
    </item>
</selector>
