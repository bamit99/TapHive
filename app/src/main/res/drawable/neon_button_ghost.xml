<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#142032" />
            <corners android:radius="12dp" />
            <stroke android:color="@color/neon_cyan" android:width="1dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0A1220" />
            <corners android:radius="12dp" />
            <stroke android:color="@color/neon_dim" android:width="1dp" />
        </shape>
    </item>
</selector>
